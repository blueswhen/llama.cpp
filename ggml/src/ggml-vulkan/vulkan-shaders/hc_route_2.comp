#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(constant_id = 0) const uint BLOCK_SIZE = 128;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter {
    uint n_embd;
    uint n_logits;
    uint n_iter;
    uint nbx1;
    uint nbx2;
    uint nbw1;
    uint nbd1;
    uint x_offset;
    uint w_offset;
    uint b_offset;
    uint n_offset;
    uint d_offset;
    float norm_eps;
    float pre_scale;
};

layout(binding = 0, std430) readonly buffer X { float data_x[]; };
layout(binding = 1, std430) readonly buffer W { float data_w[]; };
layout(binding = 2, std430) readonly buffer B { float data_b[]; };
layout(binding = 3, std430) readonly buffer N { float data_n[]; };
layout(binding = 4, std430) writeonly buffer D { float data_d[]; };
layout(binding = 0, std430) readonly buffer X4 { vec4 data_x4[]; };
layout(binding = 1, std430) readonly buffer W4 { vec4 data_w4[]; };
layout(binding = 3, std430) readonly buffer N4 { vec4 data_n4[]; };
layout(binding = 4, std430) writeonly buffer D4 { vec4 data_d4[]; };

shared float partial[10][BLOCK_SIZE];

vec4 load_x(uint i, bool packed) {
    return packed ? data_x4[i/4] : vec4(data_x[i], 0, 0, 0);
}

vec4 load_w(uint i, bool packed) {
    return packed ? data_w4[i/4] : vec4(data_w[i], 0, 0, 0);
}

void store_sum(uint index, float value) {
    value = subgroupAdd(value);
    if (subgroupElect()) {
        partial[index][gl_SubgroupID] = value;
    }
}

float sum_partials(uint index) {
    float v = 0.0;
    for (uint i = gl_SubgroupInvocationID; i < gl_NumSubgroups; i += gl_SubgroupSize) {
        v += partial[index][i];
    }
    return subgroupAdd(v);
}

float sigmoid(float x) {
    return 1.0/(1.0 + exp(-x));
}

float softplus(float x) {
    return max(x, 0.0) + log(1.0 + exp(-abs(x)));
}

vec4 sinkhorn_2(vec4 logits) {
    const float d0 = logits.x - logits.y;
    const float d1 = logits.z - logits.w;
    float a = softplus(-d1) - softplus(-d0);
    float b = softplus( d1) - softplus( d0);

    if (n_iter > 1) {
        const float hi = max(a, 0.0) + max(b, 0.0);
        const float lo = min(a, 0.0) + min(b, 0.0);
        const float range = hi - lo;
        const float log_two = 0.6931471805599453;
        float power = log_two - softplus(-range);
        float sum = 0.0;
        bool have_sum = false;

        // Compose the two-stream normalization steps by squaring.
        for (uint n = n_iter - 1; n != 0; n >>= 1) {
            if ((n & 1) != 0) {
                sum = have_sum ? (sum + softplus(power - sum)) - softplus((sum + power) - range) : power;
                have_sum = true;
            }
            if (n > 1) {
                power = (power - softplus(2.0*power - range)) + log_two;
            }
        }
        const float shift = softplus(sum - hi) - softplus(sum + lo);
        a += shift;
        b += shift;
    }
    return vec4(sigmoid(a), sigmoid(-a), sigmoid(b), sigmoid(-b));
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint it = gl_WorkGroupID.x;
    const uint a = x_offset + it*nbx2;
    const uint b = a + nbx1;
    const uint dst = d_offset + it*nbd1;
    const bool packed = ((n_embd | a | b | w_offset | nbw1 | n_offset | dst) & 3) == 0;
    const uint width = packed ? 4 : 1;
    float sum = 0.0;
    for (uint i = tid*width; i < n_embd; i += BLOCK_SIZE*width) {
        const vec4 av = load_x(a + i, packed);
        const vec4 bv = load_x(b + i, packed);
        sum += dot(av, av) + dot(bv, bv);
    }
    store_sum(0, sum);
    barrier();

    const float rms = inversesqrt(sum_partials(0)/(2.0*float(n_embd)) + 1e-6);
    float proj[8] = float[8](0, 0, 0, 0, 0, 0, 0, 0);
    for (uint i = tid*width; i < n_embd; i += BLOCK_SIZE*width) {
        const vec4 av = load_x(a + i, packed)*rms;
        const vec4 bv = load_x(b + i, packed)*rms;
        [[unroll]] for (uint j = 0; j < 8; ++j) {
            if (j < n_logits) {
                const uint row = w_offset + j*nbw1 + i;
                proj[j] += dot(av, load_w(row, packed)) + dot(bv, load_w(row + n_embd, packed));
            }
        }
    }
    [[unroll]] for (uint j = 0; j < 8; ++j) {
        if (j < n_logits) {
            store_sum(j + 1, proj[j]);
        }
    }
    barrier();

    const float pa = sigmoid(sum_partials(1) + data_b[b_offset]);
    const float pb = sigmoid(sum_partials(2) + data_b[b_offset + 1]);
    float branch_sum = 0.0;
    for (uint i = tid*width; i < n_embd; i += BLOCK_SIZE*width) {
        const vec4 value = pre_scale*(pa*load_x(a + i, packed) + pb*load_x(b + i, packed));
        branch_sum += dot(value, value);
    }
    store_sum(9, branch_sum);
    barrier();

    const float branch_rms = inversesqrt(sum_partials(9)/float(n_embd) + norm_eps);
    for (uint i = tid*width; i < n_embd; i += BLOCK_SIZE*width) {
        const vec4 value = pre_scale*(pa*load_x(a + i, packed) + pb*load_x(b + i, packed));
        if (packed) {
            data_d4[(dst + i)/4] = (value*branch_rms)*data_n4[(n_offset + i)/4];
        } else {
            data_d[dst + i] = (value.x*branch_rms)*data_n[n_offset + i];
        }
    }

    if (gl_SubgroupID == 0) {
        float logits[8];
        [[unroll]] for (uint j = 2; j < 8; ++j) {
            if (j < n_logits) {
                logits[j] = sum_partials(j + 1) + data_b[b_offset + j];
            }
        }
        if (subgroupElect()) {
            const uint tail = dst + n_embd;
            const vec4 mix = n_logits == 8 ? sinkhorn_2(vec4(logits[4], logits[5], logits[6], logits[7])) : vec4(1, 0, 0, 1);
            data_d[tail    ] = 2.0*sigmoid(logits[2]);
            data_d[tail + 1] = 2.0*sigmoid(logits[3]);
            data_d[tail + 2] = mix.x;
            data_d[tail + 3] = mix.y;
            data_d[tail + 4] = mix.z;
            data_d[tail + 5] = mix.w;
            data_d[tail + 6] = 0.0;
            data_d[tail + 7] = 0.0;
        }
    }
}
